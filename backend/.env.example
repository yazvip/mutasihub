# MutasiHub backend — contoh konfigurasi.
# Salin ke .env (JANGAN commit .env) dan isi nilai asli.
# Semua nilai di bawah ini placeholder, bukan secret asli.

# Port HTTP (default 8080; deploy VPS .163: 8093)
PORT=8080

# URL publik frontend Next.js (dipakai redirect balik OAuth Google)
# Lokal: http://localhost:3000 ; deploy: https://mutasi.rajacek.com
FRONTEND_URL=http://localhost:3000

# Domain cookie sesi. Kosong = host-only (lokal).
# Deploy: .rajacek.com (pelajaran Rajacek: host-only bikin login mental
# saat pindah subdomain; cookie sesi + OAuth state ikut domain ini).
COOKIE_DOMAIN=

# MySQL DSN (format go-sql-driver/mysql).
# Kosong = mode tanpa-DB: server tetap jalan, /healthz 200,
# endpoint butuh DB menjawab 503.
# Lokal: .../mutasihub ; deploy VPS 43.157.205.163:3306 database mutasi_hub
# (BUAT BARU khusus proyek ini, jangan pakai/timpa database marketplace
# atau stack lama di .163).
MYSQL_DSN=user:password@tcp(127.0.0.1:3306)/mutasihub?parseTime=true&multiStatements=true

# Secret penanda sesi JWT (isi string acak panjang, min 32 karakter)
JWT_SECRET=change-me-to-a-long-random-secret

# Kunci enkripsi kredensial member AES-256-GCM:
# 32 byte, dikodekan base64 ATAU hex. Contoh cara generate:
#   python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Connecta B2B Partner API (DANA + BCA). Base URL + key asli dari Connecta.
# TERVERIFIKASI live 2026-11-07: API ada di bawah /api/v1 (host saja
# mengembalikan halaman CRM 404). Jadi base URL WAJIB diakhiri /api/v1.
CONNECTA_BASE_URL=https://connecta-crm.digitcodestudio.com/api/v1
CONNECTA_API_KEY=your-connecta-api-key
CONNECTA_WEBHOOK_SECRET=your-connecta-webhook-secret

# Google OAuth (login member + admin allowlist)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Lokal: http://localhost:8080/api/v1/auth/google/callback
# Deploy: https://mutasi.rajacek.com/api/v1/auth/google/callback (daftarkan di Google Cloud Console)
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
# Email admin yang boleh login Google, dipisah koma
ADMIN_GOOGLE_EMAILS=admin@example.com

# Gobiz QRIS (pembayaran langganan)
GOBIZ_API_KEY=your-gobiz-api-key
GOBIZ_WEBHOOK_SECRET=your-gobiz-webhook-secret
